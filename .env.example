# Copy to .env and fill in
DATABASE_URL="mysql://username:password@localhost:3306/database_name"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
SUPER_ADMIN_EMAIL="fahadalnoman2001@gmail.com"
SUPER_ADMIN_PASSWORD="TasminaBinte@19"
SITE_URL="https://productsinmalta.com"
SITE_NAME="Products in Malta"

# MCP server (separate process)
MCP_SERVER_PORT=4000
MCP_SHARED_DB_URL="mysql://username:password@localhost:3306/database_name"
# Public path this app is reachable at from the outside (must match how it's proxied/mounted)
MCP_PUBLIC_PATH="/mcp"

# Origin of the main Next.js app, which hosts the OAuth authorization server this
# process points unauthenticated clients at (see .well-known/oauth-protected-resource)
MCP_ISSUER_URL="https://youroffers.eu"

# Main app: what the admin panel displays as the MCP connection URL
NEXT_PUBLIC_MCP_SERVER_URL="https://youroffers.eu/mcp"

# Hostinger SMTP Mailer
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="noreplay@youroffers.eu"
SMTP_PASS="your-email-password"
SMTP_FROM="noreplay@youroffers.eu"
SECURITY_NOTIFY_EMAIL="fahadalnoman2001@gmail.com"


