diff --git a/src/lib/oauthTrustedClients.ts b/src/lib/oauthTrustedClients.ts
new file mode 100644
index 0000000..e0207e6
--- /dev/null
+++ b/src/lib/oauthTrustedClients.ts
@@ -0,0 +1,40 @@
+import { prisma } from "./db";
+
+// claude.ai's connector doesn't reliably complete the Dynamic Client Registration
+// round-trip before redirecting the browser to /oauth/authorize — POST /api/oauth/register
+// works fine when tested directly, but the client_id claude.ai actually sends is
+// consistently one it generated locally, never one our /register endpoint issued.
+// Rather than depend on a DCR flow we can't debug from the outside, auto-register
+// any client_id here IF (and only if) its redirect_uri points at claude.ai's known
+// OAuth callback. Security still holds: only claude.ai's exact callback URL is
+// accepted, PKCE is still verified at the token step, and a token is only ever
+// issued after a super_admin approves on /oauth/authorize.
+const TRUSTED_REDIRECT_PREFIXES = ["https://claude.ai/api/mcp/", "https://claude.com/api/mcp/"];
+
+export function isTrustedRedirectUri(redirectUri: string): boolean {
+  return TRUSTED_REDIRECT_PREFIXES.some(p => redirectUri.startsWith(p));
+}
+
+// Returns the OAuthClient row for (clientId, redirectUri), registering it on the fly
+// if it's not known yet but the redirect_uri is trusted. Returns null if the client
+// is unknown and the redirect_uri isn't trusted (real "unknown client" case).
+export async function resolveOrAutoRegisterClient(clientId: string, redirectUri: string) {
+  const existing = await prisma.oAuthClient.findUnique({ where: { clientId } });
+  if (existing) {
+    const allowed: string[] = JSON.parse(existing.redirectUris || "[]");
+    if (allowed.includes(redirectUri)) return existing;
+    if (isTrustedRedirectUri(redirectUri)) {
+      // Same client_id reconnecting with a redirect_uri we haven't seen — extend it,
+      // rather than reject, as long as it's still a trusted claude.ai callback.
+      return prisma.oAuthClient.update({
+        where: { clientId },
+        data: { redirectUris: JSON.stringify([...allowed, redirectUri]) }
+      });
+    }
+    return null;
+  }
+  if (!isTrustedRedirectUri(redirectUri)) return null;
+  return prisma.oAuthClient.create({
+    data: { clientId, redirectUris: JSON.stringify([redirectUri]), clientName: "Claude (auto-registered)" }
+  });
+}
