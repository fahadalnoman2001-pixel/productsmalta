// Prisma schema for Productsinmalta.com
// Configured for MySQL production and development.

generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("editor")
  createdAt DateTime @default(now())
}

model Category {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  description   String?       @db.Text
  image         String?       @db.Text
  order         Int           @default(0)
  showOnHomepage Boolean      @default(true)
  subcategories Subcategory[]
  products      Product[]
  blogs         Blog[]
  createdAt     DateTime      @default(now())
}

model Subcategory {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]
  createdAt  DateTime  @default(now())

  @@index([categoryId])
}

model Product {
  id             String              @id @default(cuid())
  title          String
  slug           String              @unique
  description    String              @db.Text
  shortDesc      String?             @db.Text
  images         String              @db.Text
  price          Float
  originalPrice  Float?
  currency       String              @default("EUR")
  brand          String?
  platform       String?
  affiliateUrl   String              @db.Text
  rating         Float               @default(0)
  reviewCount    Int                 @default(0)
  categoryId     String?
  category       Category?           @relation(fields: [categoryId], references: [id])
  subcategoryId  String?
  subcategory    Subcategory?        @relation(fields: [subcategoryId], references: [id])
  tags           String              @default("[]") @db.Text
  seoTitle       String?
  seoDescription String?             @db.Text
  isFeatured     Boolean             @default(false)
  isBestSeller   Boolean             @default(false)
  isActive       Boolean             @default(true)
  clicks         Int                 @default(0)
  collections    CollectionProduct[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([isFeatured])
  @@index([isBestSeller])
}

model Collection {
  id             String              @id @default(cuid())
  name           String
  slug           String              @unique
  description    String?             @db.Text
  image          String?             @db.Text
  type           String              @default("manual")
  isActive       Boolean             @default(true)
  showOnHomepage Boolean             @default(true)
  order          Int                 @default(0)
  products       CollectionProduct[]
  createdAt      DateTime            @default(now())
}

model CollectionProduct {
  collectionId String
  productId    String
  order        Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

model Blog {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String?   @db.Text
  content        String    @db.LongText
  coverImage     String?   @db.Text
  author         String    @default("Admin")
  tags           String    @default("[]") @db.Text
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  seoTitle       String?
  seoDescription String?   @db.Text
  isPublished    Boolean   @default(true)
  isTop          Boolean   @default(false)
  views          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([categoryId])
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?  @db.Text
  image     String   @db.Text
  link      String?  @db.Text
  slot      String   @default("hero")
  slotKey   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String @db.Text
}

model MCPToken {
  id        String    @id @default(cuid())
  name      String
  token     String    @unique
  createdBy String
  isActive  Boolean   @default(true)
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
}

// --- Minimal OAuth 2.1 authorization server (for claude.ai web/mobile MCP connector) ---
// claude.ai's remote-MCP connector requires OAuth with Dynamic Client Registration; it
// cannot use a static Bearer token. These two models back a small shim: clients self
// register (DCR), then a logged-in super_admin approves the grant at /oauth/authorize,
// and the token handed back is just a normal MCPToken — so access is still controlled
// entirely by "can this person log into /admin".
model OAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  clientSecret String?  // For client_secret_post authentication
  redirectUris String   @db.Text // JSON-encoded string[]
  clientName   String?
  createdAt    DateTime @default(now())
}

model OAuthCode {
  id                  String   @id @default(cuid())
  code                String   @unique
  clientId            String
  redirectUri         String   @db.Text
  codeChallenge       String
  codeChallengeMethod String   @default("S256")
  adminUserId         String
  used                Boolean  @default(false)
  expiresAt           DateTime
  createdAt           DateTime @default(now())
}

model ClickLog {
  id        String   @id @default(cuid())
  productId String
  ip        String?
  userAgent String?  @db.Text
  referer   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([productId])
}
